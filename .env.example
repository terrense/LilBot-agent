# LilBot configuration.
# Copy this file to .env and fill in one provider.
#
# Cloud providers need a key. Local servers (Ollama, vLLM, LM Studio, LocalAI)
# do not. The offline provider needs neither a key nor a network.
#
# Provider presets: deepseek, openai, moonshot, zhipu, dashscope/qwen,
# openrouter, together, groq, mistral, siliconflow, xai, perplexity,
# fireworks, ollama, vllm, lmstudio, localai, mock.
# Any other OpenAI-compatible endpoint works with LILBOT_BASE_URL.

# --- Cloud example -----------------------------------------------------------
LILBOT_PROVIDER=deepseek
LILBOT_MODEL=deepseek-chat
LILBOT_BASE_URL=https://api.deepseek.com
LILBOT_API_KEY=replace-me

# --- Local example (no key) --------------------------------------------------
# LILBOT_PROVIDER=ollama
# LILBOT_MODEL=qwen2.5:3b
# LILBOT_BASE_URL=http://127.0.0.1:11434/v1

# --- Offline demo (no network, no key) ---------------------------------------
# LILBOT_PROVIDER=mock

# Optional tuning
# LILBOT_FALLBACK_MODEL=
# LILBOT_AUX_MODEL=
# LILBOT_MAX_STEPS=10
# LILBOT_CONTEXT_WINDOW=128000
# LILBOT_PERMISSION_MODE=ask
# LILBOT_FONT_SIZE=18
